{
  "eslint.workingDirectories": [
    {
      "directory": "frontend",
      "changeProcessCWD": true
    }
  ],
  "eslint.validate": [
    "javascript",
    "javascriptreact",
    "typescript",
    "typescriptreact"
  ],
  "typescript.tsdk": "frontend/node_modules/typescript/lib",
  "typescript.enablePromptUseWorkspaceTsdk": true,
  "java.import.maven.enabled": true,
  "java.autobuild.enabled": true,
  "java.configuration.updateBuildConfiguration": "automatic",
  "java.compile.nullAnalysis.mode": "disabled",
  "java.compiler.problem.unusedLocalVariable": "ignore",
  "java.compiler.problem.unusedParameter": "ignore",
  "java.compiler.problem.unusedImport": "ignore",
  "java.compiler.problem.unusedPrivateMember": "ignore",
  "java.compiler.problem.rawTypeReference": "ignore",
  "java.compiler.problem.deprecation": "ignore",
  "java.compiler.problem.staticMethodShouldBeAccessedInAStaticWay": "ignore",
  "editor.formatOnSave": false,
  "files.eol": "\n",
  "search.exclude": {
    "**/node_modules": true,
    "**/dist": true,
    "**/target": true,
    "legacy/**": true
  }
}
